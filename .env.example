# ===== LLM 供应商（任何兼容 OpenAI 协议的服务） =====
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding 服务（缺省复用上面三项）
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3

# ===== 安全密钥（生产务必更换为强随机值） =====
JWT_SECRET=change-me-to-a-random-64-char-string
ELIGIBILITY_SECRET=change-me-too

# ===== 智能体 =====
AGENT_MAX_ROUNDS=5
AGENT_ENABLED=true

# ===== 限流 =====
RATE_LIMIT_PER_MIN=10
GLOBAL_QPS=20

# ===== 业务 =====
COMPANY_TITLE=XX科技有限公司
